{
  "name": "@grafctory/tape",
  "version": "0.13.3",
  "description": "Simplified facade for the LogTape logging framework.",
  "keywords": [
    "typescript",
    "logging",
    "logtape"
  ],
  "homepage": "https://grafctory.github.io/tape/",
  "bugs": {
    "url": "https://github.com/grafctory/tape/issues",
    "email": "info@grafctory.dev"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Metreeca",
    "email": "info@metreeca.com",
    "url": "https://www.metreeca.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grafctory/tape.git"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@grafctory/source": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "clean": "ush rm dist docs node_modules",
    "prime": "npm ci",
    "setup": "npm ci && ush ln",
    "build": "ush rm dist docs && tsc -p tsconfig.build.json && npx typedoc",
    "check": "npx vitest --typecheck run",
    "proof": "ush up npx typedoc --watch + ush ws --open docs"
  },
  "dependencies": {
    "@logtape/logtape": "^2.3.2",
    "@grafctory/core": "^0.14.0"
  },
  "devDependencies": {
    "@grafctory/rack": "^0.8.0",
    "typedoc": "^0.28.14",
    "typescript": "^6.0.3",
    "vitest": "^4.0.13"
  },
  "allowScripts": {
    "fsevents": false
  }
}
