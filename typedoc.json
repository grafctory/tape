{
  "tsconfig": "./tsconfig.build.json",
  "includeVersion": true,
  "sort": [
    "source-order"
  ],
  "sortEntryPoints": false,
  "groupOrder": [
    "Variables",
    "Interfaces",
    "Type Aliases",
    "*"
  ],
  "useFirstParagraphOfCommentAsSummary": true,
  "favicon": "https://www.metreeca.com/200.svg",
  "sourceLinkExternal": true,
  "markdownLinkExternal": true,
  "navigationLinks": {
    "GitHub": "https://github.com/grafctory/tape"
  },
  "externalSymbolLinkMappings": {
    "@logtape/logtape": {
      "LogLevel": "https://jsr.io/@logtape/logtape/doc/~/LogLevel",
      "Config": "https://jsr.io/@logtape/logtape/doc/~/Config"
    }
  },
  "excludeExternals": true,
  "excludeReferences": true,
  "githubPages": false,
  "hideGenerator": true,
  "customFooterHtml": "<a href='https://www.metreeca.com/' style='display: flex; align-items: center; gap: 0.25em'><img src='https://www.metreeca.com/200.svg' alt='Metreeca' style='width: 1.25em; height: 1.25em;'/><span>Copyright © 2025-2026 Metreeca · Grafctory™ is a trademark of Metreeca srl</span></a>",
  "headings": {
    "readme": false
  }
}
